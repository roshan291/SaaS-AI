# =============================================================================
# API server configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS — comma-separated allow-list. Leave empty in dev to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000

# Body / rate limits
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT=20

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT — secret MUST be at least 32 chars of high-entropy randomness
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ91234454354608980!@#$%^&*)(&^@^#&#)dsafjdhfksdjasdfasfeuoirwrer
JWT_EXPIRES_IN=1h
JWT_ISSUER=saas-platform
JWT_AUDIENCE=saas-api

# Auth
BCRYPT_COST=12

# Redis (BullMQ + health probe)
REDIS_URL=rediss://<user>:<password>@<host>:6379

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Per-workspace AI rate limit (jobs / window)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=3600000

# Image storage (Cloudinary) — required for the image pipeline
# Get this from your Cloudinary dashboard → "API Environment variable".
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=
# Optional folder prefix to isolate dev/prod uploads in one account
CLOUDINARY_FOLDER=social-saas-dev

# =============================================================================
# Social platform OAuth (Instagram + Facebook + X + Pinterest + YouTube)
# =============================================================================
# Public base URL the API listens on — used to build OAuth callback URLs that
# the provider redirects back to. MUST be reachable from the user's browser
# AND registered as a valid redirect URI in every connected platform's app
# console. In dev use http://localhost:4000; in prod use https://api.yourdomain.com.
APP_PUBLIC_API_URL=http://localhost:4000
# Web app base — the OAuth callback redirects the browser here with
# ?connected=<platform> / ?error=<msg> after exchanging the code.
APP_PUBLIC_WEB_URL=http://localhost:3000

# AES-256-GCM key used to encrypt OAuth tokens at rest before they hit Mongo.
# Generate with: `openssl rand -hex 32` (64 hex chars = 32 bytes). MUST be
# stable across restarts — rotating it makes existing tokens undecryptable.
INTEGRATIONS_ENCRYPTION_KEY=

# Meta (Instagram + Facebook share one app — both providers use these creds)
# Create at https://developers.facebook.com/apps then add the Instagram
# Graph + Facebook Login products.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# X (Twitter) — OAuth 2.0 with PKCE.
# Create at https://developer.x.com/en/portal/projects-and-apps and enable
# "OAuth 2.0" with type "Confidential client". Add the redirect URI
# {APP_PUBLIC_API_URL}/api/v1/integrations/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Pinterest — Standard OAuth 2.0.
# Create at https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# YouTube (Google) — standard Google OAuth 2.0 with offline access for
# refresh tokens. Create at https://console.cloud.google.com/apis/credentials
# Enable the YouTube Data API v3 in the same project.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
