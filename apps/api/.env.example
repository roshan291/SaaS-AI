# =============================================================================
# API server configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS — comma-separated allow-list. Leave empty in dev to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000

# Body / rate limits
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT=20

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT — secret MUST be at least 32 chars of high-entropy randomness
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ91234454354608980!@#$%^&*)(&^@^#&#)dsafjdhfksdjasdfasfeuoirwrer
JWT_EXPIRES_IN=1h
JWT_ISSUER=saas-platform
JWT_AUDIENCE=saas-api

# Auth
BCRYPT_COST=12

# Redis (BullMQ + health probe)
REDIS_URL=rediss://<user>:<password>@<host>:6379

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
