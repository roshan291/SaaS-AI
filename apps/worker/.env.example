# =============================================================================
# Worker configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Database (worker shares Mongo with API)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Redis (BullMQ)
REDIS_URL=rediss://<user>:<password>@<host>:6379

# Worker tuning
WORKER_CONCURRENCY=1

# Per-queue rate limit (jobs allowed to START within the window).
# Sized for Gemini's free tier (5 RPM on gemini-2.5-flash).
# Bump these once you move to a paid Gemini plan.
WORKER_RATE_LIMIT_MAX=4
WORKER_RATE_LIMIT_WINDOW_MS=60000

# BullMQ lock tuning. The default lockDuration is 30s which is too short
# for Gemini image generation (often 30–60s) and breaks when you pause at
# a `debugger;` breakpoint in the JavaScript Debug Terminal. In production
# you can lower this (e.g. 90000 = 90s) so jobs from a truly crashed worker
# become eligible for redelivery faster.
WORKER_LOCK_DURATION_MS=300000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=2

# Stalled-job sweeper — jobs that have been "processing" longer than this are
# marked failed so the user can retry them.
STALLED_JOB_TIMEOUT_MS=600000

# BullMQ retry / retention defaults (also picked up by the queue package)
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=2000
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_COMPLETED_AGE_SEC=86400
QUEUE_KEEP_FAILED=5000
QUEUE_KEEP_FAILED_AGE_SEC=604800

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gemini image model. The "-preview" suffix that Google's docs sometimes
# show does NOT exist for end users — keep this as-is unless you switch
# to a higher tier (gemini-3.1-flash-image / gemini-3-pro-image).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Image storage (Cloudinary) — required: the worker uploads bytes here.
# Must match the same Cloudinary account as the API.
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=social-saas-dev

# =============================================================================
# Social platform publishing
# =============================================================================
# The publish worker reuses the same OAuth tokens stored by the API. Both
# processes must share the SAME encryption key so the worker can decrypt
# tokens written by the API. Copy this value from apps/api/.env exactly.
INTEGRATIONS_ENCRYPTION_KEY=

# How many publish jobs the worker runs in parallel. Each social provider
# has its own per-account rate limit; 3 is a safe POC default.
PUBLISH_WORKER_CONCURRENCY=3
