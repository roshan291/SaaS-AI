# =============================================================================
# Worker configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Database (worker shares Mongo with API)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Redis (BullMQ)
REDIS_URL=rediss://<user>:<password>@<host>:6379

# Worker tuning
WORKER_CONCURRENCY=5

# Stalled-job sweeper — jobs that have been "processing" longer than this are
# marked failed so the user can retry them.
STALLED_JOB_TIMEOUT_MS=600000

# BullMQ retry / retention defaults (also picked up by the queue package)
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=2000
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_COMPLETED_AGE_SEC=86400
QUEUE_KEEP_FAILED=5000
QUEUE_KEEP_FAILED_AGE_SEC=604800

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
