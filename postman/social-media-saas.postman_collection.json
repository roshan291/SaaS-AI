            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Acme\",\n  \"lastName\": \"Owner\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\",\n  \"workspace\": { \"name\": \"Acme Inc\", \"slug\": \"{{ownerSlug}}\" }\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.success).to.be.true;",
              "pm.collectionVariables.set('ownerToken', body.data.token);",
              "pm.test('role=owner', () => pm.expect(body.data.user.role).to.eql('owner'));"
            ]}
